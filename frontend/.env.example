# Cấu hình môi trường (Quản lý cấu hình – Ch07). Sao chép thành .env.local để dùng.

# Nguồn dữ liệu thời gian thực: "mock" (giả lập trên trình duyệt) | "websocket" (backend FastAPI)
VITE_DATA_SOURCE=mock

# Nguồn LLM: "mock" (trả lời giả lập trên trình duyệt) | "http" (gọi backend /api/llm)
VITE_LLM_PROVIDER=mock

# Địa chỉ backend. Mặc định đi qua Vite proxy (/api, /ws → http://localhost:8000) nên thường không cần đặt.
VITE_API_BASE_URL=/api
# VITE_WS_URL=ws://localhost:8000/ws

# Chu kỳ phát dữ liệu của bộ giả lập phía trình duyệt (ms)
VITE_MOCK_TICK_MS=2000
