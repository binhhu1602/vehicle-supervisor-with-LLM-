# Sao chép thành .env rồi chỉnh. KHÔNG commit file .env (chứa bí mật).
ENVIRONMENT=development

# PostgreSQL (docker compose up -d db)
DATABASE_URL=postgresql+asyncpg://trafficeye:trafficeye@localhost:5432/trafficeye

# Bảo mật – đổi giá trị khi triển khai thật
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRE_MINUTES=480
INGEST_API_KEY=dev-ingest-key
CORS_ORIGINS=["http://localhost:5173"]

# Bộ giả lập (thay cho camera + AI Vision khi chưa có thiết bị)
SIMULATOR_ENABLED=true
SIMULATOR_TICK_MS=2000
METRICS_RETENTION_DAYS=7

# LLM: auto (Claude nếu có ANTHROPIC_API_KEY, ngược lại dùng bộ trả lời theo luật) | claude | rule_based
LLM_PROVIDER=auto
LLM_MODEL=claude-opus-5-5
LLM_RATE_LIMIT_PER_MINUTE=20
# ANTHROPIC_API_KEY=sk-ant-...
